custom_components/fan_bridge/www/*.map

__pycache__/
.pytest_cache/
.ruff_cache/

# Home Assistant run by the devcontainer: everything it writes in its config
# folder (auth tokens in .storage/, database, logs) stays local. Only the
# configuration files are versioned.
.devcontainer/config/*
!.devcontainer/config/configuration.yaml
!.devcontainer/config/ui-lovelace.yaml
