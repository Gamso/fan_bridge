node_modules/
# The card bundle is built from src/ into custom_components/fan_bridge/www/
# (npm run build) and shipped in the release zip, never committed: every PR
# touching the card would otherwise conflict on it. dist/ is a leftover of
# older builds.
custom_components/fan_bridge/www/fan-bridge-card.js
custom_components/fan_bridge/www/*.map
dist/

__pycache__/
.pytest_cache/
.ruff_cache/

# Home Assistant run by the devcontainer: everything it writes in its config
# folder (auth tokens in .storage/, database, logs) stays local. Only the
# configuration files are versioned.
.devcontainer/config/*
!.devcontainer/config/configuration.yaml
!.devcontainer/config/ui-lovelace.yaml
